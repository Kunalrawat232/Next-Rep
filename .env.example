# Copy to .env.local and fill in real values. Never commit real values.

# --- Client (exposed to the browser; the anon/publishable key is public by design, RLS protects data) ---
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# --- Server only (Vercel functions in /api). Never prefix these with VITE_ ---
# Used by /api/parse to verify the caller's Supabase access token (getClaims / JWKS).
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Gemini free tier only. Never link a billing account.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-free-tier-model-name
# Optional: a different (free) model for the AI coach. Falls back to GEMINI_MODEL when empty.
COACH_MODEL=

# --- E2E / RLS integration tests only (dedicated test accounts, never real users) ---
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=
