#!/usr/bin/env bash
# Blocks commits that contain secrets. Enabled by `npm install` (see the "prepare" script).
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so secrets cannot be scanned." >&2
  echo "Install it (see docs/delivery/tooling-setup.md) and commit again." >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner
